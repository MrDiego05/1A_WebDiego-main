---
// Estudios.astro — Formación académica, certificaciones y bilingüismo
---

<section
  id="estudios"
  class="snap-section estudios-section"
  data-contrast="light"
  data-title="ESTUDIOS"
  aria-labelledby="estudios-title"
  tabindex="-1"
>
  <div class="sec-header">
    <span class="sec-num">02</span>
    <h2 class="sec-title" id="estudios-title">Estudios</h2>
    <div class="sec-rule"></div>
  </div>

  <p class="section-intro">
    Formación académica superior en la Universidad de Guayaquil, complementada
    con certificaciones, autoformación constante y competencia bilingüe.
  </p>

  <div class="estudios-grid">
    <div class="estudios-timeline">
      <article class="estudio-card estudio-card-main">
        <span class="estudio-period">2025 — presente</span>
        <h3>Ingeniería en Software</h3>
        <p class="estudio-place">Universidad de Guayaquil (UG)</p>
        <p class="estudio-desc">
          Formación en arquitectura de software, programación orientada a
          objetos, bases de datos, redes, desarrollo web y gestión de proyectos
          tecnológicos.
        </p>
        <div class="estudio-tags">
          <span>POO</span>
          <span>Bases de datos</span>
          <span>Desarrollo web</span>
          <span>Arquitectura</span>
        </div>
      </article>

      <article class="estudio-card">
        <span class="estudio-period">2024 — 2025</span>
        <h3>Bachillerato en Ciencias</h3>
        <p class="estudio-place">
          Unidad Educativa Fiscal Los Vergeles
        </p>
        <p class="estudio-desc">
          Graduación exitosa con enfoque en ciencias exactas, lógica y
          fundamentos de investigación.
        </p>
      </article>
    </div>

    <aside class="estudios-side" aria-label="Certificaciones e idiomas">
      <div class="cert-card">
        <p class="side-card-label">// CERTIFICACIONES Y CURSOS</p>
        <ul class="cert-list">
          <li>
            <span class="cert-dot" aria-hidden="true"></span>
            <div>
              <strong>Inglés — Duolingo</strong>
              <span>2024 — presente · Nivel B1–B2 en progreso</span>
            </div>
          </li>
          <li>
            <span class="cert-dot" aria-hidden="true"></span>
            <div>
              <strong>Fundamentos de Programación</strong>
              <span>Universidad de Guayaquil · en curso</span>
            </div>
          </li>
          <li>
            <span class="cert-dot" aria-hidden="true"></span>
            <div>
              <strong>Scrum y metodologías ágiles</strong>
              <span>Autoformación · en curso</span>
            </div>
          </li>
        </ul>
      </div>

      <div class="idiomas-card">
        <p class="side-card-label">// BILINGÜISMO</p>
        <div class="idioma-row">
          <div>
            <strong>Español</strong>
            <span>Nativo</span>
          </div>
          <span class="idioma-level">100%</span>
        </div>
        <div class="idioma-meter" aria-hidden="true">
          <span style="width: 100%"></span>
        </div>

        <div class="idioma-row">
          <div>
            <strong>Inglés</strong>
            <span>B1–B2 · Duolingo</span>
          </div>
          <span class="idioma-level">70%</span>
        </div>
        <div class="idioma-meter" aria-hidden="true">
          <span style="width: 70%"></span>
        </div>
      </div>
    </aside>
  </div>

  <div class="section-stickers-layer" aria-hidden="true">
    <div
      class="neo-sticker sticker-green"
      style="top: 16%; left: 82%; --rot: 4deg; transform: rotate(4deg);"
      data-sticker
    >
      <div class="sticker-inner">
        <span class="sticker-text">UG · SOFTWARE</span>
      </div>
    </div>
  </div>
</section>
