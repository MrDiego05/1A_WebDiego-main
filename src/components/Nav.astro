---
// Nav.astro — Full-width fixed header navigation bar matching screenshot layout
---

<header class="nav-container" id="nav-container">
  <nav
    id="main-nav"
    class="floating-capsule-nav"
    aria-label="Navegación principal del portfolio"
  >
    <button
      class="mobile-nav-toggle"
      type="button"
      aria-controls="nav-home-sections"
      aria-expanded="false"
      aria-label="Abrir menú de secciones"
    >
      <span class="mobile-nav-toggle-icon" aria-hidden="true">
        <span></span><span></span><span></span>
      </span>
      <span>Secciones</span>
    </button>

    <div class="nav-home-sections" id="nav-home-sections">
      <a
        href="#inicio"
        class="nav-pill pill-inicio"
        aria-current="page"
        id="nav-link-inicio"
      >
        INICIO
      </a>

      <a href="#sobre-mi" class="nav-pill pill-sobre" id="nav-link-sobre">
        PERFIL
      </a>

      <a href="#estudios" class="nav-pill pill-sobre" id="nav-link-estudios">
        ESTUDIOS
      </a>

      <a href="#conocimientos" class="nav-pill pill-sobre" id="nav-link-conocimientos">
        CONOCIMIENTOS
      </a>

      <a href="#habilidades" class="nav-pill pill-sobre" id="nav-link-habilidades">
        HABILIDADES
      </a>

      <a href="#experiencia" class="nav-pill pill-exp" id="nav-link-exp">
        EXPERIENCIA
      </a>

      <a
        href="#galeria-proyectos"
        class="nav-pill pill-proyectos"
        id="nav-link-proyectos"
        title="Descubre los proyectos"
      >
        PROYECTOS
      </a>

      <a href="#logros" class="nav-pill pill-sobre" id="nav-link-logros">
        LOGROS
      </a>

      <a href="#referencias" class="nav-pill pill-sobre" id="nav-link-referencias">
        REFERENCIAS
      </a>

      <a href="#contacto" class="nav-pill pill-contacto" id="nav-link-contacto">
        CONTACTO
      </a>
    </div>

    <div class="nav-controls-group">
      <button
        id="sidebar-dark-toggle"
        class="sidebar-btn"
        type="button"
        title="Cambiar Modo Oscuro / Claro"
        aria-label="Alternar modo oscuro y claro"
      >
        <svg
          class="sidebar-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
        </svg>
      </button>

      <button
        id="sidebar-a11y-toggle"
        class="sidebar-btn sidebar-btn-highlight"
        type="button"
        title="Accesibilidad Universal"
        aria-label="Abrir panel de accesibilidad universal"
        aria-expanded="false"
        aria-controls="a11y-advanced-panel"
      >
        <svg
          class="sidebar-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="12" cy="5" r="2"></circle>
          <path d="m9 20 3-6 3 6"></path>
          <path d="m6 8 6 2 6-2"></path>
          <path d="M12 10v4"></path>
        </svg>
        <span class="a11y-badge-pulse" aria-hidden="true"></span>
      </button>
    </div>
  </nav>
</header>
