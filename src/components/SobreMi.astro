---
// SobreMi.astro — Acerca de mí: perfil de Ingeniería de Software, enfoque Profesional 4.0 y estadísticas clave
---

<section
  id="sobre-mi"
  class="snap-section sobre-section"
  data-contrast="dark"
  data-title="ACERCA DE MÍ"
  aria-labelledby="sobre-mi-title"
  tabindex="-1"
>
  <div class="sec-header">
    <span class="sec-num">01</span>
    <h2 class="sec-title" id="sobre-mi-title">Acerca de mí</h2>
    <div class="sec-rule"></div>
  </div>

  <div class="perfil-grid">
    <div class="perfil-main">
      <p class="perfil-kicker">// PERFIL PROFESIONAL 4.0</p>
      <h3 class="perfil-name">Diego Vizueta</h3>
      <p class="perfil-role">
        Estudiante de Ingeniería en Software · Universidad de Guayaquil
      </p>
      <p class="perfil-bio">
        Futuro ingeniero en Software apasionado por la resolución de problemas y
        la innovación. Combino formación técnica, aprendizaje continuo y
        colaboración ágil para aportar ideas y sumar en proyectos de equipo.
        Actualmente construyo experiencia en desarrollo web full stack, diseño
        UI/UX y automatización.
      </p>
      <div class="perfil-badges" aria-label="Enfoque profesional">
        <span>Profesional 4.0</span>
        <span>Aprendizaje continuo</span>
        <span>Colaboración ágil</span>
        <span>Pensamiento crítico</span>
      </div>
    </div>

    <div class="perfil-stats" aria-label="Estadísticas clave">
      <div class="perfil-stat">
        <span class="perfil-stat-value">6+</span>
        <span class="perfil-stat-label">Proyectos</span>
      </div>
      <div class="perfil-stat">
        <span class="perfil-stat-value">3</span>
        <span class="perfil-stat-label">Certificaciones y cursos</span>
      </div>
      <div class="perfil-stat">
        <span class="perfil-stat-value">2</span>
        <span class="perfil-stat-label">Idiomas</span>
      </div>
      <div class="perfil-stat">
        <span class="perfil-stat-value">1</span>
        <span class="perfil-stat-label">Evento LATAM</span>
      </div>
    </div>
  </div>

  <div class="perfil-meta" aria-label="Datos de perfil">
    <div class="perfil-meta-item">
      <span>Carrera</span>
      <strong>Ingeniería en Software</strong>
    </div>
    <div class="perfil-meta-item">
      <span>Universidad</span>
      <strong>Universidad de Guayaquil (UG)</strong>
    </div>
    <div class="perfil-meta-item">
      <span>Ubicación</span>
      <strong>Guayaquil, Ecuador</strong>
    </div>
    <div class="perfil-meta-item">
      <span>Disponibilidad</span>
      <strong>Prácticas y proyectos</strong>
    </div>
  </div>

  <!-- Stickers anclados a la sección Acerca de mí -->
  <div class="section-stickers-layer" aria-hidden="true">
    <div
      class="neo-sticker sticker-purple"
      style="top: 14%; left: 78%; --rot: 5deg; transform: rotate(5deg);"
      data-sticker
    >
      <div class="sticker-inner">
        <img
          draggable="false"
          src="/stickers/ddeb9a0e427dfb83b9fb3e3cf093dde7.png"
          alt=""
        />
      </div>
    </div>

    <div
      class="neo-sticker sticker-green"
      style="top: 80%; left: 20%; --rot: -4deg; transform: rotate(-4deg);"
      data-sticker
    >
      <div class="sticker-inner">
        <img
          draggable="false"
          src="/stickers/726124634c7d9e562aea76e8ea83bf14.png"
          alt=""
        />
      </div>
    </div>
  </div>
</section>
